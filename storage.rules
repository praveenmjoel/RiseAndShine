rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Any signed-in user can read (needed for customer file viewer)
    // Any signed-in user can write (admin uploads files via the admin panel)
    // Security: customers only see files for products they purchased —
    //   the library page filters by Firestore order records, not by storage paths.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
