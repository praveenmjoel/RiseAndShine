rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Enquiry leads: anyone can create (form submissions), only admin can read/edit/delete
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Worksheet orders: anyone can create (after payment), only admin can read/edit/delete
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Products: public read, auth-only write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Site settings (Razorpay key ID etc): public read, auth-only write
    // Note: Key ID is a public identifier (not a secret). Key Secret is never stored here.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customer profiles: users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders: anyone can create (post-payment), user reads own orders, admin reads all
    match /orders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || request.auth != null);
      allow update, delete: if request.auth != null;
    }
  }
}
